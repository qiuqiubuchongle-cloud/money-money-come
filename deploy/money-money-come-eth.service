[Unit]
Description=Money Money Come ETH meme radar
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/money-money-come
EnvironmentFile=/opt/money-money-come/deploy/server.env
Environment=PATH=/root/.local/bin:/root/.bun/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env node scripts/monitor_eth_meme_radar.mjs
Restart=always
RestartSec=10
StandardOutput=append:/opt/money-money-come/logs/eth-meme-radar.log
StandardError=append:/opt/money-money-come/logs/eth-meme-radar.err.log

[Install]
WantedBy=multi-user.target
