# Money Money Come server runtime config
# Copy this file to deploy/server.env on your server, then fill secrets there.
# Do not commit deploy/server.env.

# OKX / OnchainOS
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
OKX_PROFILE_TIME_FRAME_DAYS=3

# Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_ID=
TELEGRAM_PROXY=

# Optional network proxy
HTTPS_PROXY=
HTTP_PROXY=
ALL_PROXY=
BINANCE_PROXY=

# Server signal pool
SMART_WALLET_PROFILES_PATH=config/server-core-profiles.json
SMART_WALLET_GROUPS_PATH=config/server-core-groups.json
SMART_WALLET_ADDRESSES_PATH=config/server-core-addresses.txt
SIGNAL_RULES_PATH=config/signal-rules.json

# Private smart-wallet alert rules
# You can also copy config/signal-rules.example.json to config/signal-rules.json
# and edit the same thresholds in JSON.
POLL_MS=60000
PRIVATE_WINDOW_MS=120000
MIN_PRIVATE_WALLETS=3
STRONG_PRIVATE_WALLETS=3
PRIVATE_SAME_GROUP_REQUIRED=1
CROSS_GROUP_OBSERVE_ENABLED=1
OBSERVE_SIGNAL_ENABLED=1
OBSERVE_WINDOW_MS=300000
OBSERVE_MIN_WALLETS=2
OBSERVE_SAME_GROUP_REQUIRED=1
OBSERVE_REQUIRE_EXTERNAL_CONFIRM=0

# OKX official Signal channel
OKX_OFFICIAL_SIGNAL_ENABLED=1
OKX_OFFICIAL_FORWARD_ENABLED=1
OKX_OFFICIAL_APPLY_LOCAL_FILTERS=0
OKX_SIGNAL_WALLET_TYPES=
OKX_SIGNAL_LIMIT=30
OKX_SIGNAL_MIN_WALLETS=
OKX_SIGNAL_MAX_WALLETS=
OKX_SIGNAL_MIN_AMOUNT_USD=
OKX_SIGNAL_MAX_AMOUNT_USD=
OKX_SIGNAL_MIN_MARKET_CAP_USD=
OKX_SIGNAL_MAX_MARKET_CAP_USD=
OKX_SIGNAL_MIN_LIQUIDITY_USD=
OKX_SIGNAL_MAX_LIQUIDITY_USD=
OKX_SIGNAL_MIN_HOLDERS=0
OKX_SIGNAL_MAX_TOP10_HOLDER_PERCENT=0
OKX_SIGNAL_MAX_SOLD_RATIO_PERCENT=100
OKX_SIGNAL_MIN_COMPOSITE_SCORE=3

# ETH meme radar. This is independent from the BSC grouped monitor.
ETH_OKX_SIGNAL_ENABLED=1
ETH_HOT_TOKENS_ENABLED=1
ETH_PRIVATE_TRACKER_ENABLED=1
ETH_PRIVATE_ADDRESSES_PATH=config/eth-watch-addresses.txt
ETH_PRIVATE_MIN_WALLETS=2
ETH_PRIVATE_WINDOW_MS=300000
ETH_MEME_MIN_COMPOSITE_SCORE=5
ETH_MEME_MAX_RISK_SCORE=6
ETH_MEME_ALERT_LATE_SIGNALS=0
ETH_TG_INCLUDE_DIAGNOSTICS=0
ETH_MEME_MIN_VOLUME_5M_USD=10000
ETH_MEME_MIN_TXS_5M=20
ETH_MEME_VOLUME_SPIKE_MULTIPLIER=3
ETH_MEME_MAX_MARKET_CAP_USD=20000000
ETH_MEME_MIN_LIQUIDITY_USD=10000
ETH_MEME_MIN_HOLDERS=30
ETH_MEME_MAX_TOP10_HOLDER_PERCENT=45
ETH_LIFECYCLE_EARLY_MAX_MARKET_CAP_USD=500000
ETH_LIFECYCLE_LATE_MIN_MARKET_CAP_USD=5000000
ETH_LIFECYCLE_OVERHEAT_PRICE_CHANGE_5M_PCT=150
ETH_RPC_URL=
ETH_BLOCK_TRACKING_ENABLED=0
ETH_GAS_RADAR_ENABLED=1
ETH_GAS_RADAR_MIN_GWEI=20
ETH_GAS_RADAR_SPIKE_MULTIPLIER=1.6
ETH_GAS_RADAR_BLOCKS=3
ETH_GAS_RADAR_MIN_BUYS=5
ETH_GAS_RADAR_MIN_BUYERS=3
ETH_GAS_RADAR_COOLDOWN_MS=900000
ETH_GAS_RADAR_TX_LIMIT=160
ETH_GAS_RADAR_PROTOCOL_ADDRESSES=
ETH_GAS_RADAR_IGNORE_TOKENS=

# Paper observation. This is not auto trading.
PAPER_SIZE_USD=10

# Optional enhancer sources. Keep disabled for the first server run.
BINANCE_MEME_RUSH_ENABLED=0
BINANCE_TOKEN_INFO_ENABLED=0

# Entry filters
MAX_ENTRY_MARKET_CAP_USD=500000
MIN_ENTRY_LIQUIDITY_USD=2000
MIN_ENTRY_HOLDERS=10
REQUIRE_ENTRY_LIQUIDITY=1
REQUIRE_ENTRY_HOLDERS=1

# Simulated observation rules. This is not auto trading.
STOP_LOSS_PCT=-25
TAKE_PROFIT_1_PCT=50
TAKE_PROFIT_2_PCT=100
TRAIL_DRAWDOWN_PCT=35
