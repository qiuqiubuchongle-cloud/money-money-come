[Unit]
Description=Money Money Come BSC smart-money signal monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/money-money-come
EnvironmentFile=/opt/money-money-come/deploy/server.env
Environment=PATH=/root/.local/bin:/root/.bun/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env node scripts/monitor_bsc_signals.mjs
Restart=always
RestartSec=10
StandardOutput=append:/opt/money-money-come/logs/server-monitor.log
StandardError=append:/opt/money-money-come/logs/server-monitor.err.log

[Install]
WantedBy=multi-user.target
